@page "/scenarios/create"
@using ChildcareCalculator.Domain.Models
@using ChildcareCalculator.Infrastructure.Data
@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager

<PageTitle>Nieuw Scenario - Kinderopvangtoeslag Rekentool</PageTitle>

<h1>Nieuw Scenario</h1>

<EditForm Model="@scenario" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h3>Scenario Gegevens</h3>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label for="name">Naam *</label>
                <InputText id="name" @bind-Value="scenario.Name" class="form-control" />
                <ValidationMessage For="@(() => scenario.Name)" />
            </div>

            <div class="form-group">
                <label for="description">Beschrijving</label>
                <InputTextArea id="description" @bind-Value="scenario.Description" class="form-control" rows="3" />
            </div>

            <div class="form-group form-check">
                <InputCheckbox id="isActive" @bind-Value="scenario.IsActive" class="form-check-input" />
                <label for="isActive" class="form-check-label">Actief</label>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">
            <span class="oi oi-check"></span> Opslaan
        </button>
        <a href="/scenarios" class="btn btn-secondary">
            Annuleren
        </a>
    </div>
</EditForm>

@code {
    private HouseholdScenario scenario = new()
    {
        Name = "Nieuw Scenario",
        IsActive = true,
        ValidFrom = DateTime.UtcNow
    };

    private async Task HandleValidSubmit()
    {
        DbContext.HouseholdScenarios.Add(scenario);
        await DbContext.SaveChangesAsync();
        NavigationManager.NavigateTo($"/scenarios/edit/{scenario.Id}");
    }
}
