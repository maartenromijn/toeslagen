@page "/scenarios"
@using ChildcareCalculator.Domain.Models
@using ChildcareCalculator.Infrastructure.Data
@inject ApplicationDbContext DbContext

<PageTitle>Scenario's - Kinderopvangtoeslag Rekentool</PageTitle>

<h1>Scenario's</h1>

<div class="mb-3">
    <a href="/scenarios/create" class="btn btn-primary">
        <span class="oi oi-plus"></span> Nieuw Scenario
    </a>
</div>

@if (scenarios.Count == 0)
{
    <div class="alert alert-info">
        Er zijn nog geen scenario's aangemaakt.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Naam</th>
                    <th>Beschrijving</th>
                    <th>Actief</th>
                    <th>Aangemaakt</th>
                    <th>Acties</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var scenario in scenarios)
                {
                    <tr>
                        <td>@scenario.Name</td>
                        <td>@scenario.Description</td>
                        <td>@(scenario.IsActive ? "Ja" : "Nee")</td>
                        <td>@scenario.CreatedAtUtc.ToString("dd-MM-yyyy")</td>
                        <td>
                            <a href="/scenarios/edit/@scenario.Id" class="btn btn-sm btn-outline-primary">
                                Bewerken
                            </a>
                            <a href="/scenarios/duplicate/@scenario.Id" class="btn btn-sm btn-outline-secondary">
                                Dupliceren
                            </a>
                            <a href="/results?scenarioId=@scenario.Id" class="btn btn-sm btn-outline-success">
                                Resultaten
                            </a>
                            <button @onclick="() => DeleteScenario(scenario.Id)" class="btn btn-sm btn-outline-danger">
                                Verwijderen
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<HouseholdScenario> scenarios = new();

    protected override async Task OnInitializedAsync()
    {
        scenarios = await DbContext.HouseholdScenarios
            .OrderByDescending(s => s.CreatedAtUtc)
            .ToListAsync();
    }

    private async Task DeleteScenario(Guid scenarioId)
    {
        if (await ShowDeleteConfirmation())
        {
            var scenario = await DbContext.HouseholdScenarios.FindAsync(scenarioId);
            if (scenario != null)
            {
                DbContext.HouseholdScenarios.Remove(scenario);
                await DbContext.SaveChangesAsync();
                scenarios = await DbContext.HouseholdScenarios.ToListAsync();
            }
        }
    }

    private async Task<bool> ShowDeleteConfirmation()
    {
        // In a real implementation, this would show a modal dialog
        return await Task.FromResult(true);
    }
}
