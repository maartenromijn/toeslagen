@page "/import"
@using System.Text.Json
@using ChildcareCalculator.Domain.Models
@using ChildcareCalculator.Infrastructure.Data
@using ChildcareCalculator.Application.Services
@inject ApplicationDbContext DbContext
@inject JsonImportExportService JsonImportExportService
@inject NavigationManager NavigationManager

<PageTitle>Import/Export - Kinderopvangtoeslag Rekentool</PageTitle>

<h1>Import en Export</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h3>Import JSON</h3>
            </div>
            <div class="card-body">
                <p>Importeer een scenario uit een JSON-bestand:</p>
                
                <div class="form-group">
                    <label for="jsonFile">Selecteer JSON-bestand</label>
                    <InputFile id="jsonFile" @onchange="HandleFileSelected" class="form-control" accept=".json" />
                </div>

                <div class="form-group mt-2">
                    <label for="scenarioName">Scenario Naam</label>
                    <InputText id="scenarioName" @bind-Value="importScenarioName" class="form-control" 
                              placeholder="Naam voor geïmporteerd scenario" />
                </div>

                @if (importError != null)
                {
                    <div class="alert alert-danger mt-2">
                        @importError
                    </div>
                }

                @if (importSuccess)
                {
                    <div class="alert alert-success mt-2">
                        Scenario succesvol geïmporteerd!
                    </div>
                }

                <button @onclick="ImportJson" class="btn btn-success mt-2" disabled="@(selectedFile == null)">
                    <span class="oi oi-data-transfer-upload"></span> Importeren
                </button>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h3>Export Scenario</h3>
            </div>
            <div class="card-body">
                <p>Exporteer een scenario naar JSON:</p>
                
                <div class="form-group">
                    <label for="scenarioSelect">Selecteer Scenario</label>
                    <select id="scenarioSelect" @bind="selectedScenarioId" class="form-control">
                        <option value="">-- Selecteer een scenario --</option>
                        @foreach (var scenario in scenarios)
                        {
                            <option value="@scenario.Id">@scenario.Name</option>
                        }
                    </select>
                </div>

                <button @onclick="ExportJson" class="btn btn-primary mt-2" disabled="@(selectedScenarioId == Guid.Empty)">
                    <span class="oi oi-data-transfer-download"></span> Exporteren
                </button>

                @if (exportedJson != null)
                {
                    <div class="mt-3">
                        <h5>Geëxporteerd JSON:</h5>
                        <textarea class="form-control" rows="10" readonly>@exportedJson</textarea>
                        <button @onclick="CopyToClipboard" class="btn btn-sm btn-outline-secondary mt-1">
                            Kopiëren naar klembord
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h3>Import van JSON-bestand</h3>
            </div>
            <div class="card-body">
                <p>U kunt ook een JSON-bestand uploaden:</p>
                <InputFile @onchange="HandleJsonFileUpload" class="form-control" accept=".json" />
            </div>
        </div>
    </div>
</div>

@code {
    private List<HouseholdScenario> scenarios = new();
    private Guid selectedScenarioId = Guid.Empty;
    private string importScenarioName = "Geïmporteerd Scenario";
    private IBrowserFile? selectedFile;
    private string? importedJson;
    private string? importError;
    private bool importSuccess = false;
    private string? exportedJson;

    protected override async Task OnInitializedAsync()
    {
        scenarios = await DbContext.HouseholdScenarios
            .OrderBy(s => s.Name)
            .ToListAsync();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        importError = null;
        importSuccess = false;
    }

    private async Task HandleJsonFileUpload(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        importError = null;
        importSuccess = false;
    }

    private async Task ImportJson()
    {
        if (selectedFile == null)
            return;

        try
        {
            using (var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024)) // 10MB max
            using (var reader = new StreamReader(stream))
            {
                importedJson = await reader.ReadToEndAsync();
            }

            var scenario = await JsonImportExportService.ImportScenarioFromJsonAsync(importedJson, importScenarioName);
            
            DbContext.HouseholdScenarios.Add(scenario);
            await DbContext.SaveChangesAsync();

            importSuccess = true;
            importError = null;
            selectedFile = null;
            
            // Refresh scenarios list
            scenarios = await DbContext.HouseholdScenarios.ToListAsync();
        }
        catch (Exception ex)
        {
            importError = $"Fout bij importeren: {ex.Message}";
            importSuccess = false;
        }
    }

    private async Task ExportJson()
    {
        if (selectedScenarioId == Guid.Empty)
            return;

        var scenario = await DbContext.HouseholdScenarios.FindAsync(selectedScenarioId);
        if (scenario == null)
            return;

        exportedJson = JsonImportExportService.ExportScenarioToJson(scenario);
    }

    private async Task CopyToClipboard()
    {
        if (exportedJson != null)
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", exportedJson);
        }
    }
}
