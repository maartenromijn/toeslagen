    "kot_2027_table_note": "Voorlopige gereconstrueerde staffel; <=71903 96%, 71904-175430 2026-basis + 5.1 procentpunt, >175430 2026-basis + 2.6 procentpunt."
  },
  "formulas": [
    {
      "id": "annual_contract_hours",
      "category": "calculated",
      "expression": "contract_hours_week * 52",
      "inputs": [
        "contract_hours_week"
      ]
    },
    {
      "id": "normal_daily_wage",
      "category": "calculated",
      "expression": "monthly_salary * 12 * (1 + holiday_allowance_pct) / 261",
      "inputs": [
        "monthly_salary",
        "holiday_allowance_pct"
      ]
    },
    {
      "id": "wazo_daily_benefit",
      "category": "calculated",
      "expression": "min(normal_daily_wage, uwv_maximum_daily_wage) * uwv_wazo_pct"
    },
    {
      "id": "wazo_replacement_ratio",
      "category": "calculated",
      "expression": "wazo_daily_benefit / normal_daily_wage"
    },
    {
      "id": "salary_after_leave",
      "category": "calculated",
      "expression": "annual_salary * (1 - unpaid_leave_hours / annual_contract_hours - paid_wazo_hours / annual_contract_hours) + paid_wazo_hours / hours_per_day * wazo_daily_benefit"
    },
    {
      "id": "profit_factor_after_leave",
      "category": "calculated",
      "expression": "1 - unpaid_leave_hours / annual_contract_hours - paid_wazo_hours / annual_contract_hours * (1 - wazo_replacement_ratio)"
    },
    {
      "id": "excess_profit_factor_after_leave",
      "category": "calculated",
      "expression": "1 - (unpaid_leave_hours + paid_wazo_hours) / annual_contract_hours"
    },
    {
      "id": "taxable_income_before_home",
      "category": "calculated",
      "expression": "employer_salary_after_leave + holiday_allowance + wazo_benefit + car_benefit*12 + taxable_allowance*12 + profit_after_leave + excess_profit_after_leave + other_taxable_income + manual_correction - employee_pension - employee_wia"
    },
    {
      "id": "mortgage_monthly_interest",
      "category": "calculated",
      "expression": "opening_balance * annual_interest_rate / 12"
    },
    {
      "id": "mortgage_monthly_principal",
      "category": "calculated",
      "expression": "min(opening_balance, regular_payment + extra_payment - monthly_interest)"
    },
    {
      "id": "mortgage_closing_balance",
      "category": "calculated",
      "expression": "opening_balance - monthly_principal"
    },
    {
      "id": "mortgage_average_balance_year",
      "category": "calculated",
      "expression": "average(monthly_opening_balance, monthly_closing_balance)"
    },
    {
      "id": "home_imputed_income",
      "category": "calculated",
      "expression": "woz_value * imputed_rental_value_pct"
    },
    {
      "id": "home_balance",
      "category": "calculated",
      "expression": "home_imputed_income - deductible_mortgage_interest"
    },
    {
      "id": "assessment_income",
      "category": "calculated",
      "expression": "person1_taxable_income + person2_taxable_income + home_imputed_income - deductible_mortgage_interest - other_box1_deductions"
    },
    {
      "id": "income_at_2026_boundaries",
      "category": "calculated",
      "expression": "assessment_income / income_boundary_index_factor"
    },
    {
      "id": "base_kot_percentage",
      "category": "calculated",
      "expression": "lookup_band(income_at_2026_boundaries, kot_2026_table.first_child)"
    },
    {
      "id": "automatic_kot_percentage",
      "category": "calculated",
      "expression": "year == 2027 ? (assessment_income <= 71903 ? 0.96 : min(0.96, base_kot_percentage + (assessment_income <= 175430 ? 0.051 : 0.026))) : min(0.96, base_kot_percentage + policy_surcharge)"
    },
    {
      "id": "used_kot_percentage",
      "category": "calculated",
      "expression": "coalesce(kot_percentage_override, automatic_kot_percentage)"
    },
    {
      "id": "childcare_hours_year",
      "category": "calculated",
      "expression": "childcare_weeks * days_per_week * hours_per_day"
    },
    {
      "id": "actual_childcare_cost",
      "category": "calculated",
      "expression": "childcare_hours_year * actual_hourly_rate"
    },
    {
      "id": "eligible_childcare_cost",
      "category": "calculated",
      "expression": "childcare_hours_year * min(actual_hourly_rate, maximum_hourly_rate)"
    },
    {
      "id": "childcare_allowance",
      "category": "calculated",
      "expression": "eligible_childcare_cost * used_kot_percentage"
    },
    {
      "id": "own_contribution_year",
      "category": "calculated",
      "expression": "actual_childcare_cost - childcare_allowance"
    },
    {
      "id": "own_contribution_month",
      "category": "calculated",
      "expression": "own_contribution_year / 12"
    }
  ],
